# ONYX — Online Storage System — Platform environment (docs/design/11)
# Copy to .env and fill in secrets. .env is git-ignored.

# --- Platform identity -------------------------------------------------------
DOMAIN=onyx.innotel.us
# Container image tag used by the compose stack (latest, or a release tag).
IMAGE_TAG=latest

# --- Nginx Proxy Manager (provisioned via API by scripts/npm-proxy-hosts.py) --
# NPM admin account (created on first UI login — see setup.sh).
NPM_BASE_URL=http://127.0.0.1:81
NPM_EMAIL=admin@example.com
NPM_PASSWORD=change-me

# Wildcard certificate: Let's Encrypt DNS-01 via RFC 2136 (TSIG) — the same
# pattern as the other innotelinc platform projects. Point DNS_NAMESERVER at
# the authoritative server that accepts dynamic updates for *.onyx.innotel.us.
DNS_NAMESERVER=ns.innotel.us:53
TSIG_KEY_NAME=onyx-key.
TSIG_KEY_SECRET=base64-tsig-secret==
TSIG_KEY_ALGORITHM=hmac-sha256

# --- Authentik (identity / SSO) ---------------------------------------------
# AUTHENTIK_MODE: remote (default) uses a shared external Authentik instance;
#                 local starts the bundled Authentik server, PostgreSQL, and
#                 Redis as a Compose profile replacement.
AUTHENTIK_MODE=remote
# AUTHENTIK_URL: the Authentik API endpoint. In local mode this defaults to
#                http://127.0.0.1:9000; in remote mode set it to the shared
#                IdentityOps instance (e.g. https://auth.innotel.us).
AUTHENTIK_URL=
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=latest
# Required for AUTHENTIK_MODE=local (the bundled replacement).
AUTHENTIK_SECRET_KEY=generate-a-long-random-string
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_TOKEN=generate-a-long-random-string
AUTHENTIK_BOOTSTRAP_EMAIL=admin@onyx.innotel.us
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
# Written by scripts/provision-authentik.sh after it creates the ONYX OIDC app.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# --- Device trust (docs/design/11 §10) — optional -----------------------------
# off      : no device certificates (passkeys still available via Authentik)
# local    : ONYX runs the device CA; issue certs with
#            scripts/provision-device-trust.sh issue <name> [days]
# cerulean : Cerulean (remote control plane) runs the CA + MDM; certificates
#            are issued/revoked from the Cerulean dashboard and ONYX requests
#            the mTLS gate from Cerulean's API (needs the CERULEAN_* vars)
DEVICE_TRUST=off
# Subdomains gated by device certificates when DEVICE_TRUST != off.
DEVICE_TRUST_SUBDOMAINS='app admin'
# local mode only: where the device CA lives on this host.
ONYX_PKI_DIR=/etc/onyx/pki
DEVICE_CERT_DAYS=365

# --- Cerulean (remote control plane: edge/NPM + device trust) ------------------
# Only required when DEVICE_TRUST=cerulean or NPM_MODE=cerulean.
CERULEAN_API_URL=
CERULEAN_API_TOKEN=
FLEET_ID=

# --- Storage root, cloud catalog and LAN ports ---------------------------------
# Where pools are mounted on the host. Every onyx container bind-mounts this same
# path with :rshared propagation, so a pool onyx-privd mounts reaches onyx-api,
# onyx-davd and app containers. setup.sh makes the host path shared.
ONYX_STORAGE_ROOT=/mnt/onyx
# Directory holding the shared rclone remote catalog. The Shares page writes
# remotes into it; onyx-backupd and onyx-objectstore read them, so a provider is
# configured once for tiering, clones and backups.
RCLONE_CONFIG_DIR=./data/rclone
# Host ports NPM proxies for the WebDAV and object-storage surfaces.
ONYX_WEBDAV_PORT=2082
ONYX_OBJECTSTORE_PORT=2090

# --- App runtime (onyx-appd) --------------------------------------------------
# onyx-appd runs app containers through the host's Docker engine, so it needs
# the docker socket's group. Set this to the host's docker gid:
#   DOCKER_GID=$(getent group docker | cut -d: -f3)
DOCKER_GID=999

# --- Object storage + hybrid cloud (onyx-objectstore) -------------------------
# Static credentials for the S3 endpoint at storage.onyx.innotel.us.
S3_ACCESS_KEY=onyx-access-key
S3_SECRET_KEY=generate-a-long-random-string
# Optional hybrid-cloud endpoint for CLOUD/TIERED buckets (S3-compatible).
# The preferred form is an rclone remote configured on the Shares page (a
# bucket's cloud_target); this endpoint+credentials form is for a deployment
# that does not use the catalog.
HYBRID_CLOUD_ENDPOINT=

# --- AI Storage Advisor / Backup Intelligence (onyx-ai) -----------------------
# ONYX consumes the AI plane, it does not own one: the platform runs ONE
# OmniRoute (Group 2, on the gateway host 192.168.1.46) and every platform points
# at it; ONYX runs no gateway of its own. So this is a gateway address + key
# path, NOT an upstream provider key — ONYX never ships one.
#
# The address is the SSO proxy in front of the gateway (:20129), not the
# gateway's own port: Cerulean SSO is the gateway's only gate, so 20128 answers
# on that host's loopback and bridge alone and a LAN target there is dead. The
# proxy exempts /v1 for API clients, which is what makes this a usable target.
#
# The key may be a reference, resolved at startup before it is read:
#   OMNIROUTE_API_KEY=vault://cerulean/onyx#OMNIROUTE_API_KEY
# A reference that cannot be resolved stops the service; it never becomes an
# empty credential.
OMNIROUTE_BASE_URL=http://192.168.1.46:20129/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
#
# Documented local/BYO-key escape hatch (docs/design/07 §Privacy). Leave both
# empty for deterministic local heuristics; the gateway above wins when set.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Subdomain → service routing (npm-proxy-hosts.py) ------------------------
# "subdomain=container:port" pairs, space separated. Defaults shown; override
# to point elsewhere (all subdomains hang off $DOMAIN).
NPM_SUBDOMAINS='app=onyx-web:80 api=onyx-api:8080 auth=authentic-server:9000 storage=onyx-objectstore:9000 backup=onyx-backupd:8084 admin=onyx-api:8080'
# local (default): setup.sh provisions the local NPM (wildcard TSIG cert +
# proxy hosts). cerulean: the edge/NPM is remotely managed by Cerulean —
# setup.sh skips local NPM provisioning entirely.
NPM_MODE=local

# ─── Cerulean Vault (SecretOps — HashiCorp Vault, KV v2) ───────────
# Innotel Platform Stack: secrets live in Cerulean's Vault. `.env` is derived
# and carries `vault://<mount>/<path>#<key>` references rather than values:
#   S3_ACCESS_KEY=vault://cerulean/onyx#S3_ACCESS_KEY
# The platform runs Vault as `cerulean-vault`; this stack gets the path-scoped
# `onyx` policy (VAULT_PRODUCT_TOKENS=onyx over there), delivered as
# ./data/vault/token/onyx.token. Never the root token, never the mount-wide
# `cerulean` policy.
#
#   export VAULT_ADDR=http://127.0.0.1:8200        # from inside a container: http://host.docker.internal:8200
#   export VAULT_TOKEN_FILE=./data/vault/token/onyx.token
#   python3 scripts/vault-migrate.py --dry-run     # what would move
#   python3 scripts/vault-migrate.py --from-env-file .env \\
#       --keys S3_ACCESS_KEY,S3_SECRET_KEY,CERULEAN_API_TOKEN
#
# Runtime resolution (onyx-api, onyx-objectstore, onyx-ai): a credential value
# may be a `vault://` reference; a plain value passes through untouched. There is
# no second store — Infisical is retired, not a fallback.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TOKEN_FILE=./data/vault/token/onyx.token
VAULT_PREFIX=cerulean
VAULT_PATH=onyx
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=
