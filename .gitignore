# Repo-local toolchain (see scripts/bootstrap-tools.sh)
.tools/

# Build artifacts
bin/
services/*/target/
# A service built in place (`go build ./services/ai`) writes ./ai at the repo root
# rather than bin/onyx-ai — which is how an 18 MB binary ended up committed. The
# Makefile is the only path that puts binaries where they belong.
/onyx
/ai

# OSTree image compose outputs (base/compose.sh + assemble-boot.sh); keep the
# assember script itself tracked.
base/repo/
base/image/sysroot/

# Dev runtime state (sockets, state dirs, logs)
.run/

# Secrets + local env (setup.sh copies from .env.example)
.env

# Vault token copies (data/vault/token/<product>.token) — a live credential.
# Cerulean's Vault bootstrap mints it; each stack mounts its own copy read-only.
data/vault/token/
# Dev-mode Vault storage + init material (compose.vault.yml, VAULT_INIT_FILE)
data/vault/file/
data/vault/init/

# Device-trust PKI (scripts/provision-device-trust.sh) — private keys, never commit
issued/
*.p12
*.csr

# Built docs site (mkdocs.yml -> site_dir; built in CI for Pages)
web/landing/docs/

# Go caches (kept under .tools/)
*.swp
.DS_Store
# Python bytecode
__pycache__/

# Env snapshots (pre-migration backups, .env.bak-<ts>, …) — these hold live
# credentials. Never tracked: they leaked once (see the 2026-09-15 cleanup).
.env.pre-*
.env.bak*
.env.*.bak
