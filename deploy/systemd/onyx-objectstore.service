# onyx-objectstore — S3-compatible object storage + hybrid cloud
# (docs/design/11 §6.6). Serves the S3 gateway (storage.onyx.innotel.us) and
# tiers CLOUD/TIERED buckets through the shared rclone remote catalog that the
# Shares page writes and onyx-backupd reads.
[Unit]
Description=Onyx object storage service
After=local-fs.target onyx-pool.service

[Service]
Type=simple
User=onyx-objectstore
Group=onyx
SupplementaryGroups=onyx
ExecStart=/usr/local/lib/onyx/onyx-objectstore --socket-dir /run/onyx --state-dir /var/lib/onyx/objectstore --rclone-config /etc/rclone/rclone.conf
Restart=always
RestartSec=2
UMask=0002
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/onyx /var/lib/onyx/objectstore

[Install]
WantedBy=multi-user.target
