# onyx-appd — application/container management (docs/design/11 §6.4): the signed
# app catalog, per-install configuration, and container lifecycle through the
# Docker API. Install records persist in SQLite under the state directory.
[Unit]
Description=Onyx application service
After=local-fs.target onyx-pool.service docker.service
Wants=docker.service

[Service]
Type=simple
User=onyx-appd
Group=onyx
SupplementaryGroups=onyx
ExecStart=/usr/local/lib/onyx/onyx-appd --socket-dir /run/onyx --state-dir /var/lib/onyx/appd
Restart=always
RestartSec=2
UMask=0002
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/onyx /var/lib/onyx/appd

[Install]
WantedBy=multi-user.target
