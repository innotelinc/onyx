# onyx-vmm — virtualization service (docs/design/11 §6.3): VM inventory in
# SQLite, disk images on the pool, and lifecycle through `virsh` on the libvirt
# backend. Runs unprivileged in the libvirt group, which is what lets it talk to
# the hypervisor without root; VM images live under the pool's @apps/vms, so they
# are snapshotted and backed up with everything else.
[Unit]
Description=Onyx virtualization service
After=local-fs.target onyx-pool.service libvirtd.service
Wants=libvirtd.service

[Service]
Type=simple
User=onyx-vmm
Group=onyx
SupplementaryGroups=onyx libvirt kvm
ExecStart=/usr/local/lib/onyx/onyx-vmm --socket-dir /run/onyx --state-dir /var/lib/onyx/vmm --disk-root /mnt/onyx/main-pool/@apps/vms
Restart=always
RestartSec=2
UMask=0002
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# /mnt/onyx is the pool root: disk images are created and deleted here.
ReadWritePaths=/run/onyx /var/lib/onyx/vmm /mnt/onyx

[Install]
WantedBy=multi-user.target
